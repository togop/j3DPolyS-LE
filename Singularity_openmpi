Bootstrap: docker
From:   togop/gcc_gfortran_openmpi_hdf5_python_uv:2025-05-31

%labels
    Author todor.gitchev@gmail.com
    Version v2025.2

%help
    3D Polymer Simulation of chromosome folding by modeled loop extrusion
    Available commands:
        3dpolys_le
        3dpolys_le_runner
        3dpolys_le_stats
        plot_hic
        plot_sim_stats
        hdf5_to_cooler
        hic_converters

%environment
     export OMPI_ALLOW_RUN_AS_ROOT=1
     export OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1
     export OMPI_DIR=/opt/ompi
     export SINGULARITY_OMPI_DIR=$OMPI_DIR
     export SINGULARITYENV_PREPEND_LD_LIBRARY_PATH=$OMPI_DIR/lib
     export PATH=$OMPI_DIR/bin:/opt/uv:/3DPolyS-LE/.venv/bin:$PATH
     export SINGULARITYENV_PREPEND_PATH=$OMPI_DIR/bin:/opt/uv:/3DPolyS-LE/.venv/bin
     export VIRTUAL_ENV="/3DPolyS-LE/.venv"

%post
    # Update package lists before installing
    # Allow release info changes (handles Debian stable codename updates)
    apt-get update --allow-releaseinfo-change || apt-get update
    # Install py3dpolys_le package
    PATH=/opt/uv:$PATH
    export PATH=$PATH
    echo 'export PATH=/opt/uv:$PATH' >> $SINGULARITY_ENVIRONMENT

    #echo "Installing Open MPI"
    apt-get install -y  bash wget
    export OMPI_DIR=/opt/ompi
    export OMPI_VERSION=4.1.8
    export OMPI_URL="https://download.open-mpi.org/release/open-mpi/v4.1/openmpi-$OMPI_VERSION.tar.bz2"
    mkdir -p /tmp/ompi
    mkdir -p /opt
    cd /tmp/ompi && wget -O openmpi-$OMPI_VERSION.tar.bz2 $OMPI_URL && tar -xjf openmpi-$OMPI_VERSION.tar.bz2
    # Compile and install
    cd /tmp/ompi/openmpi-$OMPI_VERSION && ./configure --prefix=$OMPI_DIR && make install
    # Set env variables so we can compile our application
    export PATH=$OMPI_DIR/bin:$PATH
    export LD_LIBRARY_PATH=$OMPI_DIR/lib:$LD_LIBRARY_PATH
    export MANPATH=$OMPI_DIR/share/man:$MANPATH

    apt-get install -y git
    cd /
    git clone https://gitlab.com/togop/3DPolyS-LE.git -b develop
    cd 3DPolyS-LE
    PATH=/opt/uv:$PATH
    export PATH
    make venv
    export UV_LINK_MODE=copy
    make all
    # Ensure the venv bin directory is in PATH for future use
    echo 'export PATH=/3DPolyS-LE/.venv/bin:$PATH' >> $SINGULARITY_ENVIRONMENT

%runscript
    # echo "Container py3DPolyS_LE was created $NOW"
    # echo "Arguments received: $*"
    cd /3DPolyS-LE && . .venv/bin/activate && exec "$@"
