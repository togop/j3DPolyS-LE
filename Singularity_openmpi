Bootstrap: docker
From: togop/gcc_gfortran_openmpi_hdf5_python:latest

%labels
    Author todor.gitchev@gmail.com
    Version v2022.4.14

%help
    3D Polymer Simulation of chromosome folding by modeled loop extrusion
    Available commands:
        3dpolys_le
        3dpolys_le_runner
        3dpolys_le_stats
        plot_hic
        plot_sim_stats
        hdf5_to_cooler
        hic_converters

%environment
     SINGULARITYENV_APPEND_PATH=/opt/miniconda3/bin:
     export SINGULARITYENV_APPEND_PATH
     export PATH=/opt/miniconda3/bin:$PATH
     # TODO find real location
     export OMPI_ALLOW_RUN_AS_ROOT=1
     export OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1
     export OMPI_DIR=/opt/ompi
     export SINGULARITY_OMPI_DIR=$OMPI_DIR
     export SINGULARITYENV_APPEND_PATH=$OMPI_DIR/bin
     export SINGULAIRTYENV_APPEND_LD_LIBRARY_PATH=$OMPI_DIR/lib
     # if using from the Docke image: not tested
     # export OMPI_DIR=/usr/bin
     # export SINGULARITY_OMPI_DIR=$OMPI_DIR
     # export SINGULARITYENV_APPEND_PATH=$OMPI_DIR
     # export SINGULAIRTYENV_APPEND_LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/openmpi/lib/

%post
    apt-get update
    # Install py3dpolys_le package
    PATH=/opt/miniconda3/bin:$PATH
    export PATH=$PATH
    echo 'export PATH=/opt/miniconda3/bin:$PATH' >> $SINGULARITY_ENVIRONMENT
    conda update -q conda
    conda config --add channels bioconda
    conda config --add channels conda-forge
    conda config --add channels defaults
    # conda install -y -q --file requirements_dev.txt python=3.8
    conda install -y -q numpy cython pandas matplotlib scipy filelock h5py dask cooler pyranges seaborn python=3.9
    conda install -y -q cmake
    # pip install Cython
    # apt-get update && apt-get install -y git
    # skip update: sometimes cause problems
    apt-get install -y git bash wget

    echo "Installing Open MPI"
    export OMPI_DIR=/opt/ompi
    export OMPI_VERSION=4.1.3
    export OMPI_URL="https://download.open-mpi.org/release/open-mpi/v4.1/openmpi-$OMPI_VERSION.tar.bz2"
    mkdir -p /tmp/ompi
    mkdir -p /opt
    cd /tmp/ompi && wget -O openmpi-$OMPI_VERSION.tar.bz2 $OMPI_URL && tar -xjf openmpi-$OMPI_VERSION.tar.bz2
    # Compile and install
    cd /tmp/ompi/openmpi-$OMPI_VERSION && ./configure --prefix=$OMPI_DIR && make install
    # Set env variables so we can compile our application
    export PATH=$OMPI_DIR/bin:$PATH
    export LD_LIBRARY_PATH=$OMPI_DIR/lib:$LD_LIBRARY_PATH
    export MANPATH=$OMPI_DIR/share/man:$MANPATH

    cd /
    git clone https://gitlab.com/togop/3DPolyS-LE.git -b develop
    cd 3DPolyS-LE
    make build
    pip install -e /3DPolyS-LE

%runscript
    echo "Container py3DPolyS_LE was created $NOW"
    echo "Arguments received: $*"
    exec echo "$@"
